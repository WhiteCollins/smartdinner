# SmartDinner Flutter .env example
# NUNCA uses la service_role_key en el frontend
# Copia este archivo como `.env` en la raíz y completa los valores.

# Supabase (Frontend)
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Servicios locales (útil para desarrollo)
API_BASE_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
